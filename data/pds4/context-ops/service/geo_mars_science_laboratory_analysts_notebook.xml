    <Archive_Resource>
        <name>Mars Science Laboratory Analyst's Notebook</name>
        <version_id>1.0</version_id>
        <url>http://an.rsl.wustl.edu/msl</url>
        <resource_type>Service</resource_type>
        <resource_subtype>Scientific Analysis Tool</resource_subtype>
        <resource_subtype>Search Tool</resource_subtype>
        <resource_subtype>Visualization Tool</resource_subtype>
        <resource_subtype>Web Application</resource_subtype>
        <interface_type>GUI Interface</interface_type>
        <description>The Mars Science Laboratory Analyst’s Notebook is a web-based tool for accessing and exploring science and engineering data from NASA’s Mars Science Laboratory (Curiosity) mission. It integrates publicly available data from instrument teams with sequence information, documentation, and contextual materials describing observational context, processing methodology, and data formats. The Notebook supports detailed review and mission replay and provides access to data curated by the Planetary Data System, though it is not itself the official archive.</description>
        <pds4_wide_applicability>false</pds4_wide_applicability>
    </Archive_Resource>
