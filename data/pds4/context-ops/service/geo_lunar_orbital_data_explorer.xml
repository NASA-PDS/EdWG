        <title>Lunar Orbital Data Explorer</title>
        <information_model_version>1.26.0.0</information_model_version>
        <product_class>Product_Resource</product_class>
    </Identification_Area>
    <Archive_Resource>
        <name>Lunar Orbital Data Explorer</name>
        <version_id>1.0</version_id>
        <url>https://ode.rsl.wustl.edu/moon</url>
        <resource_type>Service</resource_type>
        <resource_subtype>Scientific Analysis Tool</resource_subtype>
        <resource_subtype>Search Tool</resource_subtype>
        <resource_subtype>Visualization Tool</resource_subtype>
        <resource_subtype>Web Application</resource_subtype>
        <interface_type>GUI Interface</interface_type>
        <description>The Lunar Orbital Data Explorer (ODE) is a web-based tool that provides cross-mission and cross-instrument faceted product search, interactive map search, display, and download options for PDS data from major lunar orbital missions, including LRO, GRAIL, Clementine, Lunar Prospector, Lunar Orbiter, JAXA's SELENE, and ISRO’s Chandrayaan-1. ODE includes a REST API for querying the ODE database from scripts, code, and other tools. A granular data system (GDS) supports retrieving subsets of point data from LRO DIVINER and LOLA data products, with output in the form of CSV files, GIS shape files, and binned images.</description>
        <pds4_wide_applicability>false</pds4_wide_applicability>
    </Archive_Resource>
