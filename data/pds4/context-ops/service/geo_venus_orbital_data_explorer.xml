    <Archive_Resource>
        <name>Venus Orbital Data Explorer</name>
        <version_id>1.0</version_id>
        <url>https://ode.rsl.wustl.edu/venus</url>
        <resource_type>Service</resource_type>
        <resource_subtype>Scientific Analysis Tool</resource_subtype>
        <resource_subtype>Search Tool</resource_subtype>
        <resource_subtype>Visualization Tool</resource_subtype>
        <resource_subtype>Web Application</resource_subtype>
        <interface_type>GUI Interface</interface_type>
        <description>The Venus Orbital Data Explorer (ODE) is a web-based tool that provides cross-mission and cross-instrument faceted product search, interactive map search, display, and download options for PDS data from major Venus orbital missions. It offers access to data from the Magellan mission, Venus observations from the MESSENGER mission, and ESA's Venus Express mission. ODE includes a REST API for querying the ODE database from scripts, code, and other tools.</description>
        <pds4_wide_applicability>false</pds4_wide_applicability>
